    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-wallets": "^0.19.37",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.84.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.19.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-router-dom": "^5.3.3",
    "@walletconnect/web3-provider": "^1.8.0",
    "buffer": "^6.0.3",
    "chart.js": "^4.5.0",
    "d3": "^7.9.0",
    "lightweight-charts": "^5.0.8",
    "lucide-react": "^0.539.0",
    "process": "^0.11.10",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "reactflow": "^11.11.4",
    "recharts": "^3.1.2",
    "sonner": "^1.5.0",
    "typescript": "^5.0.0",
    "viem": "^2.33.2",
    "wagmi": "^2.16.1"
  },
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "dev:demo": "cross-env VITE_DEMO_MODE=true vite --config config/vite.config.ts",
    "dev:real": "cross-env VITE_DEMO_MODE=false vite --config config/vite.config.ts",
    "build": "vite build --config config/vite.config.ts",
    "preview": "vite preview",
    "deploy": "npm run build && git add docs && git commit -m 'Deploy to GitHub Pages' && git push",
    "deploy:live-demo": "npm run build && git add docs && git commit -m 'deploy: Strategy Builder & Bot integration to live-demo' && git push origin live-demo",
    "setup:devnet": "ts-node scripts/setup-devnet.ts",
    "smoke:devnet": "RPC=https://api.devnet.solana.com ts-node scripts/smoke-test.ts",
    "smoke:strategy": "ts-node scripts/strategy-smoke.ts",
    "test:quick": "node scripts/comprehensive-devnet-test.js",
    "test:demo": "DEMO_MODE=true node scripts/comprehensive-devnet-test.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "cross-env": "^10.0.0",
    "ts-node": "^10.9.1",
    "vite": "^5.0.0",
    "vite-plugin-node-polyfills": "^0.24.0"
  }
}
